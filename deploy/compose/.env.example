# 部署环境模板（方案 A：服务器本地构建，不依赖 GHCR）。
# 用法：复制为 deploy/compose/.env 并填写全部必填变量；缺失时 `docker compose config` 直接报错。
# 生成随机密钥：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 注意：.env 已被 gitignore 排除，不得提交。

# --- 认证（必填；UTF-8 编码后至少 32 字节；不得与限流/供应商凭证复用）---
AUTH_JWT_SECRET_KEY=

# --- 限流（必填；主体摘要密钥，≥32 字节随机串）---
RATE_LIMIT_SUBJECT_HMAC_KEY=
# 经 nginx 反代时，把反代所在地址加入可信代理，后端才读取 X-Forwarded-For 的真实客户端 IP
# （否则所有用户共享反代 IP 的限流桶）。nginx 与 API 同机时用 127.0.0.1/32。
RATE_LIMIT_TRUSTED_PROXY_CIDRS=127.0.0.1/32

# --- 模型出口网关（全部必填；endpoint 必须是 HTTPS，部署模式拒绝 HTTP）---
# 示例：DeepSeek https://api.deepseek.com/v1 · 智谱 https://open.bigmodel.cn/api/paas/v4
MODEL_GATEWAY_ENDPOINT=https://api.example.com/v1
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_QUERY_REWRITE_MODEL=
MODEL_GATEWAY_GENERATION_MODEL=
# 可选：留空禁用 reranker（直接使用 RRF）
# MODEL_GATEWAY_RERANK_MODEL=

# --- 基础设施 ---
# PostgreSQL 密码（默认 orionamesh，生产务必修改；DATABASE_URL 会同步引用）
# POSTGRES_PASSWORD=

# --- 构建参数（可选；国内服务器 npmjs/pypi 慢或不可达时指向镜像）---
# NPM_REGISTRY=https://registry.npmmirror.com
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# --- 前端（同源反代时用相对路径 /v1；NEXT_PUBLIC_ 为构建时常量，最终由前端 API 客户端决定）---
# NEXT_PUBLIC_API_BASE_URL=/v1
