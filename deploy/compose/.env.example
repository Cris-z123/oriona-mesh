# 服务器运行秘密：复制为 /opt/orionamesh/.env，chmod 600，绝不提交。
# BACKEND_IMAGE/FRONTEND_IMAGE 来自 GitHub Release 的 release.env，由部署脚本自动叠加，
# 不要在本文件固定为 latest。

# 使用 `openssl rand -hex 32` 生成；不得复用旧密码。
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# 使用两个不同的 `openssl rand -hex 48` 值。
AUTH_JWT_SECRET_KEY=
RATE_LIMIT_SUBJECT_HMAC_KEY=

# nginx 与 API 都在 Compose 内网；仅 API 没有主机端口暴露时才可信任该私网范围。
# 默认覆盖 Docker 默认地址池（172.16.0.0/12）。首次部署后按 quickstart「验证」小节核对
# Compose 网络实际子网（docker network inspect orionamesh_default）；若 Docker 地址池被
# 自定义为其他网段（如 10.x/192.168.x），用实际子网替换此处，否则 nginx 不被信任、限流
# 会按代理 IP 聚合。
RATE_LIMIT_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# 模型出口网关（endpoint 必须为 HTTPS；凭证不得提交或发送到聊天）。
MODEL_GATEWAY_ENDPOINT=https://api.example.com/v1
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_QUERY_REWRITE_MODEL=
MODEL_GATEWAY_GENERATION_MODEL=
MODEL_GATEWAY_RERANK_MODEL=
