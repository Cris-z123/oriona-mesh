# 自动化测试环境模板：复制为 backend/.env.test 后填写（.env.test 已被 gitignore）。
# pytest 夹具（tests/conftest.py）在导入应用前加载本文件并固定 APP_ENV=test；
# 环境变量优先级高于本文件；conftest 已用 setdefault 提供标准测试默认值，
# 本文件只用于覆盖需要变更的测试值。

# 测试数据库：测试夹具会 DROP SCHEMA CASCADE 重建并 TRUNCATE 全部表，
# 请使用独立测试库，切勿指向开发或生产库。
TEST_DATABASE_URL=postgresql+psycopg://orionamesh:orionamesh@localhost:5432/orionamesh_test
# Redis（限流集成测试与契约测试使用；不可用时相关测试自动 skip）
REDIS_URL=redis://localhost:6379/0

# conftest 提供以下标准测试默认值（无需设置，除非要变更行为）：
#   APP_ENV=test
#   DOCUMENT_STORAGE_ROOT=<系统临时目录>/orionamesh-test-storage
#   AUTH_JWT_SECRET_KEY / RATE_LIMIT_SUBJECT_HMAC_KEY（测试专用随机串）
#   MODEL_GATEWAY_ENDPOINT=http://localhost:19999/v1（本机回环例外，仅测试）
#   MODEL_GATEWAY_API_KEY / QUERY_REWRITE_MODEL / GENERATION_MODEL（测试替身）
#   DATABASE_URL=TEST_DATABASE_URL（提供时统一使用测试库）
