# 本地开发环境模板：复制为 backend/.env.local 后填写（.env.local 已被 gitignore）。
# APP_ENV=development（默认）时由 backend/app/core/settings.py 自动加载本文件；
# 环境变量优先级高于本文件。算法 HS256 与 Access TTL 7200 秒为代码常量，无覆盖变量。
# 完整变量契约以 specs/001-orionamesh-rag-mvp/quickstart.md 为准。

# 数据库（开发库；需 vector/pg_trgm/pgcrypto 扩展）
DATABASE_URL=postgresql+psycopg://orionamesh:orionamesh@localhost:5432/orionamesh
# 测试库（自动化测试使用；运行 pytest 时加载 .env.test）
TEST_DATABASE_URL=postgresql+psycopg://orionamesh:orionamesh@localhost:5432/orionamesh_test
# Redis（限流计数与 Celery 队列）
REDIS_URL=redis://localhost:6379/0

# 认证：必填，UTF-8 编码后至少 32 字节；不得与限流/供应商凭证复用。
# 算法 HS256 与 7200 秒 TTL 是代码常量，不提供环境变量覆盖。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET_KEY=

# 限流：必填主体摘要密钥（同样使用随机长串，不得与 AUTH_JWT_SECRET_KEY 复用）。
RATE_LIMIT_SUBJECT_HMAC_KEY=
# 可信反向代理 CIDR 逗号列表；为空时忽略全部转发头并使用直连对端 IP。
# RATE_LIMIT_TRUSTED_PROXY_CIDRS=
# 阈值与窗口使用 quickstart 默认值：auth IP 20/300s、auth account 5/300s、
# upload 10/600s、question 20/60s、default 120/60s；可按需覆盖：
# RATE_LIMIT_AUTH_IP_LIMIT=20
# RATE_LIMIT_AUTH_IP_WINDOW_SECONDS=300
# RATE_LIMIT_AUTH_ACCOUNT_LIMIT=5
# RATE_LIMIT_AUTH_ACCOUNT_WINDOW_SECONDS=300
# RATE_LIMIT_UPLOAD_LIMIT=10
# RATE_LIMIT_UPLOAD_WINDOW_SECONDS=600
# RATE_LIMIT_QUESTION_LIMIT=20
# RATE_LIMIT_QUESTION_WINDOW_SECONDS=60
# RATE_LIMIT_DEFAULT_LIMIT=120
# RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
# RATE_LIMIT_READ_FAIL_OPEN=true

# 资料持久卷（本地开发可指向本机目录；部署环境必须显式注入）
DOCUMENT_STORAGE_ROOT=/data/orionamesh
# 单用户同时处理名额 / worker 心跳失联回收边界 / 上传转正接管边界（秒）
# DOCUMENT_PROCESSING_MAX_PER_USER=3
# DOCUMENT_PROCESSING_LEASE_SECONDS=300
# DOCUMENT_UPLOAD_PENDING_TIMEOUT_SECONDS=300
# 单份资料解析超时（秒） / DOCX 等归档解压后总大小上限（字节）
# DOCUMENT_PARSE_TIMEOUT_SECONDS=60
# DOCUMENT_PARSE_MAX_EXPANDED_BYTES=209715200
# 上传 Idempotency-Key 结果保留期（秒）
# DOCUMENT_UPLOAD_IDEMPOTENCY_TTL_SECONDS=86400

# 模型出口网关：provider 固定为 openai-compatible；endpoint 必填。
# 生产/联调使用 HTTPS base URL；仅本机回环开发（localhost/127.0.0.1/::1）允许 HTTP。
# 非法认证配置、缺失/不允许的 HTTP endpoint 或未知 provider 拒绝就绪。
MODEL_GATEWAY_PROVIDER=openai-compatible
MODEL_GATEWAY_ENDPOINT=https://api.example.com/v1
MODEL_GATEWAY_API_KEY=
# 脱敏策略版本（固定 v1）；正文审计必须保持关闭（true 时启动拒绝）
# MODEL_GATEWAY_SANITIZER_POLICY_VERSION=v1
# MODEL_GATEWAY_AUDIT_PAYLOADS=false
# 模型：Embedding 默认 text-embedding-3-small（1536 维）；改写与生成必填；Reranker 留空禁用
# MODEL_GATEWAY_EMBEDDING_MODEL=text-embedding-3-small
MODEL_GATEWAY_QUERY_REWRITE_MODEL=
MODEL_GATEWAY_GENERATION_MODEL=
# MODEL_GATEWAY_RERANK_MODEL=
# 超时/重试（默认：embedding 30s/2 次、改写 10s/1 次、rerank 10s/1 次、
# 生成首 token 15s/总时长 120s/1 次）；仅网关执行，业务层不得再次重试
# MODEL_GATEWAY_EMBEDDING_TIMEOUT_SECONDS=30
# MODEL_GATEWAY_EMBEDDING_MAX_RETRIES=2
# MODEL_GATEWAY_QUERY_REWRITE_TIMEOUT_SECONDS=10
# MODEL_GATEWAY_QUERY_REWRITE_MAX_RETRIES=1
# MODEL_GATEWAY_RERANK_TIMEOUT_SECONDS=10
# MODEL_GATEWAY_RERANK_MAX_RETRIES=1
# MODEL_GATEWAY_GENERATION_FIRST_TOKEN_TIMEOUT_SECONDS=15
# MODEL_GATEWAY_GENERATION_TOTAL_TIMEOUT_SECONDS=120
# MODEL_GATEWAY_GENERATION_MAX_RETRIES=1

# 检索证据门槛（闭区间 [0,1]）与 assistant streaming 失联上限（秒）。
# MESSAGE_STREAMING_STALE_SECONDS 默认 360，必须不小于全部改写/重排/生成尝试预算 + 60 秒。
# RETRIEVAL_VECTOR_MIN_SIMILARITY=0.65
# RETRIEVAL_TRGM_MIN_SIMILARITY=0.30
# MESSAGE_STREAMING_STALE_SECONDS=360
