# 本地开发环境模板：复制为 backend/.env.local 后填写（.env.local 已被 gitignore）。
# APP_ENV=development（默认）时由 backend/app/core/settings.py 自动加载本文件；
# 环境变量优先级高于本文件。算法 HS256 与 Access TTL 7200 秒为代码常量，无覆盖变量。

# 数据库（开发库；需 vector/pg_trgm/pgcrypto 扩展）
DATABASE_URL=postgresql+psycopg://orionamesh:orionamesh@localhost:5432/orionamesh
# 测试库（自动化测试使用；运行 pytest 时加载 .env.test）
TEST_DATABASE_URL=postgresql+psycopg://orionamesh:orionamesh@localhost:5432/orionamesh_test
# Redis（限流计数与 Celery 队列）
REDIS_URL=redis://localhost:6379/0

# 认证：必填，UTF-8 编码后至少 32 字节；不得与限流/供应商凭证复用。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET_KEY=

# 限流：必填主体摘要密钥（同样使用随机长串）。
RATE_LIMIT_SUBJECT_HMAC_KEY=

# 模型出口网关：必填 endpoint（HTTPS；本机回环开发可用 HTTP）、API Key 与模型。
MODEL_GATEWAY_ENDPOINT=https://api.example.com/v1
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_QUERY_REWRITE_MODEL=
MODEL_GATEWAY_GENERATION_MODEL=
# 可选：为空则禁用 reranker（直接使用 RRF）
MODEL_GATEWAY_RERANK_MODEL=

# 资料持久卷（本地开发可指向本机目录；部署环境必须显式注入）
DOCUMENT_STORAGE_ROOT=/data/orionamesh
